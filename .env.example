# PostgreSQL (valores de desarrollo; cambia la contraseña fuera de local)
POSTGRES_DB=gyv_process_mining
POSTGRES_USER=gyv_user
POSTGRES_PASSWORD=gyv_password
POSTGRES_HOST=database
POSTGRES_PORT=5432

# URL usada por SQLAlchemy dentro de Docker
DATABASE_URL=postgresql+psycopg://gyv_user:gyv_password@database:5432/gyv_process_mining

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
DEVIATION_INACTIVITY_HOURS=72
ML_SNAPSHOT_INTERVAL_HOURS=12
ML_MODEL_DIR=/app/ml/models
ALERT_RISK_THRESHOLD=0.70
ALERT_BATCH_LIMIT=100

# URL pública que usa el navegador para acceder al backend
VITE_API_URL=http://localhost:8000
